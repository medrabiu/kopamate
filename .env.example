# Postgres connection string (Supabase: Project settings > Database > Connection string > "Transaction pooler")
DATABASE_URL=postgres://postgres:password@localhost:5432/kopamate

# Public URL of the app, no trailing slash (http://localhost:3000 when running locally)
APP_URL=http://localhost:3000

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Google sign-in (optional; the Google button is hidden if these are empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who can open /admin: comma-separated emails and/or WhatsApp numbers
ADMIN_IDS=you@gmail.com,+2348031234567

# Protects the daily position snapshot job. Vercel sends it automatically when set.
CRON_SECRET=change-me-too
